---
import BaseLayout from './BaseLayout.astro';
import { SITE } from '@/config/site';
import { getPostUrl, getAllPosts, getRelatedPosts, formatDate } from '@/utils/posts';
import { slugify, normalizeHashtag, displayHashtag } from '@/utils/slugify';
import { buildToc } from '@/utils/toc';
import type { Post } from '@/utils/posts';

interface Props {
  post: Post;
  headings: Array<{ depth: number; text: string; slug: string }>;
}

const { post, headings } = Astro.props;
const { data } = post;

const allPosts    = await getAllPosts();
const postIndex   = allPosts.findIndex(p => p.id === post.id);
const prevPost    = postIndex < allPosts.length - 1 ? allPosts[postIndex + 1] : null;
const nextPost    = postIndex > 0 ? allPosts[postIndex - 1] : null;
const related     = getRelatedPosts(post, allPosts);
const toc         = buildToc(headings);

const postUrl = new URL(getPostUrl(post), SITE.siteURL).toString();

// Series siblings
let seriesPosts: Post[] = [];
if (data.series) {
  seriesPosts = allPosts
    .filter(p => p.data.series === data.series)
    .sort((a,b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
}

// TOC numbering
let tocCounter = 0;
function tocNum() { return `${String(++tocCounter).padStart(2,'0')} —`; }

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  url: postUrl,
  datePublished: data.date.toISOString(),
  dateModified: (data.updated || data.date).toISOString(),
  author: {
    '@type': 'Person',
    name: data.author,
    url: new URL(`/author/${slugify(data.author)}/`, SITE.siteURL).toString(),
  },
  publisher: { '@type': 'Organization', name: SITE.siteName, url: SITE.siteURL },
  mainEntityOfPage: postUrl,
  ...(data.cover ? { image: new URL(data.cover, SITE.siteURL).toString() } : {}),
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonical={data.canonical || postUrl}
  ogImage={data.ogImage || data.cover}
  ogType="article"
  noindex={data.noindex}
  publishedDate={data.date}
  updatedDate={data.updated}
  author={data.author}
  schema={schema}
>
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <span class="breadcrumb__item"><a href="/">Home</a></span>
    <span class="breadcrumb__item"><a href="/latest/">Publications</a></span>
    <span class="breadcrumb__item">
      <a href={`/category/${slugify(data.category)}/`}>{data.category}</a>
    </span>
    <span class="breadcrumb__item">
      <span class="breadcrumb__current" aria-current="page">{data.title}</span>
    </span>
  </nav>

  <div class="doc-layout">

    <!-- ═══ ARTICLE MAIN ═══ -->
    <article class="doc-main" itemscope itemtype="https://schema.org/BlogPosting">

      <!-- Cover image -->
      {data.cover && (
        <img src={data.cover} alt={`Cover — ${data.title}`} class="cover-img" loading="eager" />
      )}

      <!-- Document header -->
      <header class="doc-header">
        <a href={`/category/${slugify(data.category)}/`} class="doc-header__cat">
          {data.category}
        </a>
        <h1 class="doc-header__title" itemprop="headline">{data.title}</h1>
        <p class="doc-header__desc" itemprop="description">{data.description}</p>
      </header>

      <!-- Document info table -->
      <table class="doc-info" aria-label="Document information">
        <caption>DOCUMENT INFORMATION</caption>
        <tbody>
          <tr>
            <th scope="row">Publication</th>
            <td>{SITE.siteName}</td>
          </tr>
          <tr>
            <th scope="row">Author</th>
            <td>
              <a href={`/author/${slugify(data.author)}/`} itemprop="author">{data.author}</a>
            </td>
          </tr>
          <tr>
            <th scope="row">Published</th>
            <td>
              <time datetime={data.date.toISOString()} itemprop="datePublished">
                {formatDate(data.date, 'short').toUpperCase()}
              </time>
            </td>
          </tr>
          {data.updated && data.updated.getTime() !== data.date.getTime() && (
            <tr>
              <th scope="row">Updated</th>
              <td>
                <time datetime={data.updated.toISOString()} itemprop="dateModified">
                  {formatDate(data.updated, 'short').toUpperCase()}
                </time>
              </td>
            </tr>
          )}
          <tr>
            <th scope="row">Category</th>
            <td>
              <a href={`/category/${slugify(data.category)}/`}>{data.category}</a>
            </td>
          </tr>
          <tr>
            <th scope="row">Reading Time</th>
            <td><span id="reading-time">—</span></td>
          </tr>
          {data.tags.length > 0 && (
            <tr>
              <th scope="row">Tags</th>
              <td>
                <div style="display:flex;flex-wrap:wrap;gap:4px;">
                  {data.tags.map(t => (
                    <a href={`/tag/${slugify(t)}/`} class="badge">{t}</a>
                  ))}
                </div>
              </td>
            </tr>
          )}
          {data.hashtags.length > 0 && (
            <tr>
              <th scope="row">Hashtags</th>
              <td>
                <span style="display:flex;flex-wrap:wrap;gap:8px;font-family:var(--font-mono);font-size:var(--text-xs);">
                  {data.hashtags.map(ht => (
                    <a href={`/hashtag/${normalizeHashtag(ht)}/`} class="htag">
                      {displayHashtag(ht)}
                    </a>
                  ))}
                </span>
              </td>
            </tr>
          )}
          {data.series && (
            <tr>
              <th scope="row">Series</th>
              <td>
                <a href={`/series/${slugify(data.series)}/`}>{data.series}</a>
                {data.seriesOrder != null && ` — Part ${data.seriesOrder}`}
              </td>
            </tr>
          )}
        </tbody>
      </table>

      <!-- Series navigation box -->
      {seriesPosts.length > 1 && (
        <div class="series-box" role="navigation" aria-label="Series navigation">
          <div class="series-box__head">SERIES</div>
          <div class="series-box__name">{data.series}</div>
          <ol class="series-list">
            {seriesPosts.map(sp => {
              const isCur = sp.id === post.id;
              return (
                <li class={`series-list__item${isCur ? ' series-list__item--cur' : ''}`}>
                  <span class="series-list__num">{sp.data.seriesOrder ?? '?'}.</span>
                  {isCur
                    ? <span aria-current="page">{sp.data.title}</span>
                    : <a href={getPostUrl(sp)}>{sp.data.title}</a>
                  }
                </li>
              );
            })}
          </ol>
        </div>
      )}

      <!-- Article body -->
      <div class="prose" itemprop="articleBody">
        <slot />
      </div>

      <!-- Article footer -->
      <footer class="article-footer">
        <!-- Tags -->
        {data.tags.length > 0 && (
          <div class="article-tags">
            {data.tags.map(t => (
              <a href={`/tag/${slugify(t)}/`} class="badge">{t}</a>
            ))}
          </div>
        )}

        <!-- Hashtags -->
        {data.hashtags.length > 0 && (
          <div class="article-hashtags">
            {data.hashtags.map(ht => (
              <a href={`/hashtag/${normalizeHashtag(ht)}/`} class="htag">
                {displayHashtag(ht)}
              </a>
            ))}
          </div>
        )}

        <!-- Share -->
        <div class="share-row">
          <button class="copy-link-btn" id="copy-url-btn" data-url={postUrl}>
            COPY LINK
          </button>
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`}
            target="_blank" rel="noopener noreferrer" class="share-link"
          >LINKEDIN</a>
          {SITE.seo.twitterSite && (
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(data.title)}&url=${encodeURIComponent(postUrl)}`}
              target="_blank" rel="noopener noreferrer" class="share-link"
            >SHARE ON X</a>
          )}
        </div>

        <!-- Author -->
        <div class="author-box" itemscope itemtype="https://schema.org/Person">
          <div class="author-box__avatar" aria-hidden="true">
            {data.author.charAt(0).toUpperCase()}
          </div>
          <div>
            <div class="author-box__name" itemprop="name">{data.author}</div>
            <div class="author-box__role">{SITE.authorRole}</div>
            <div class="author-box__bio">{SITE.authorBio}</div>
          </div>
        </div>

        <!-- Prev / Next -->
        <nav class="post-nav" aria-label="Article navigation">
          <div class="post-nav__item post-nav__item--prev">
            {prevPost && (
              <a href={getPostUrl(prevPost)}>
                <div class="post-nav__label">← PREVIOUS PUBLICATION</div>
                <div class="post-nav__title">{prevPost.data.title}</div>
              </a>
            )}
          </div>
          <div class="post-nav__item post-nav__item--next">
            {nextPost && (
              <a href={getPostUrl(nextPost)}>
                <div class="post-nav__label">NEXT PUBLICATION →</div>
                <div class="post-nav__title">{nextPost.data.title}</div>
              </a>
            )}
          </div>
        </nav>

        <!-- Related -->
        {related.length > 0 && (
          <div class="related-posts">
            <div class="section-bar" style="margin-bottom:0;">
              <span class="section-bar__num">REL</span>
              <span class="section-bar__title">Related Publications</span>
            </div>
            <ul class="pub-list" style="border:1px solid var(--border);border-top:none;">
              {related.map((rp, i) => (
                <li class="pub-row">
                  <span class="pub-row__num">{String(i+1).padStart(3,'0')}</span>
                  <time class="pub-row__date" datetime={rp.data.date.toISOString()}>
                    {formatDate(rp.data.date,'short')}
                  </time>
                  <a href={`/category/${slugify(rp.data.category)}/`} class="pub-row__cat">
                    {rp.data.category}
                  </a>
                  <div class="pub-row__main">
                    <div class="pub-row__title"><a href={getPostUrl(rp)}>{rp.data.title}</a></div>
                    <div class="pub-row__desc">{rp.data.description}</div>
                  </div>
                  <div class="pub-row__badges"></div>
                </li>
              ))}
            </ul>
          </div>
        )}
      </footer>
    </article>

    <!-- ═══ SIDEBAR ═══ -->
    <aside class="doc-sidebar" aria-label="Document sidebar">
      <!-- TOC -->
      {toc.length > 1 && data.toc && (
        <nav class="doc-toc" aria-label="Table of contents">
          <div class="doc-toc__head">CONTENTS</div>
          <ol class="doc-toc__list">
            {toc.map(item => (
              <li class={`doc-toc__item doc-toc__item--h${item.depth}`}>
                <a href={`#${item.slug}`}>
                  {item.depth === 2 && (
                    <span class="doc-toc__num">{item.slug}</span>
                  )}
                  {item.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <!-- Document meta compact -->
      <div class="sb-block">
        <div class="sb-block__head">Publication Info</div>
        <div class="sb-block__body">
          <div style="font-family:var(--font-mono);font-size:var(--text-xs);line-height:1.8;color:var(--text-muted);">
            <div><strong style="color:var(--text);">Date:</strong><br/>
              <time datetime={data.date.toISOString()}>{formatDate(data.date,'short')}</time>
            </div>
            <div style="margin-top:4px;"><strong style="color:var(--text);">Author:</strong><br/>
              <a href={`/author/${slugify(data.author)}/`} style="color:var(--link);">{data.author}</a>
            </div>
            <div style="margin-top:4px;"><strong style="color:var(--text);">Category:</strong><br/>
              <a href={`/category/${slugify(data.category)}/`} style="color:var(--link);">{data.category}</a>
            </div>
            <div style="margin-top:4px;"><strong style="color:var(--text);">Read time:</strong><br/>
              <span id="reading-time-sb">—</span>
            </div>
          </div>
        </div>
      </div>
    </aside>

  </div>
</BaseLayout>

<script>
  // Reading time
  const body = document.querySelector('.prose');
  if (body) {
    const words = (body.textContent || '').trim().split(/\s+/).filter(Boolean).length;
    const mins = Math.max(1, Math.ceil(words / 200));
    const label = `${mins} MIN READ`;
    const rtEl = document.getElementById('reading-time');
    if (rtEl) rtEl.textContent = label;
    const rtSb = document.getElementById('reading-time-sb');
    if (rtSb) rtSb.textContent = label;
  }

  // Copy URL
  const copyBtn = document.getElementById('copy-url-btn') as HTMLButtonElement | null;
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const url = copyBtn.dataset.url || window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        copyBtn.textContent = 'COPIED!';
        setTimeout(() => { copyBtn.textContent = 'COPY LINK'; }, 2000);
      } catch { /* silent */ }
    });
  }

  // TOC active tracking
  const tocLinks = document.querySelectorAll('.doc-toc a');
  if (tocLinks.length) {
    const headings = document.querySelectorAll('.prose h2, .prose h3, .prose h4');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          const id = e.target.getAttribute('id');
          tocLinks.forEach(l => l.classList.toggle('active', l.getAttribute('href') === `#${id}`));
        }
      });
    }, { rootMargin: '-80px 0px -60% 0px' });
    headings.forEach(h => io.observe(h));
  }

  // Code copy buttons
  document.querySelectorAll('.code-copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const block = btn.closest('.code-block');
      const code = block?.querySelector('code');
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code.textContent || '');
        btn.textContent = 'COPIED';
        btn.classList.add('copied');
        setTimeout(() => { btn.textContent = 'COPY'; btn.classList.remove('copied'); }, 2000);
      } catch { /* silent */ }
    });
  });
</script>
