---
import { SITE } from '@/config/site';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  publishedDate?: Date;
  updatedDate?: Date;
  author?: string;
  schema?: object;
}

const {
  title,
  description = SITE.siteDescription,
  canonical,
  ogImage = SITE.defaultOGImage,
  ogType = 'website',
  noindex = false,
  publishedDate,
  updatedDate,
  author = SITE.author,
  schema,
} = Astro.props;

const pageTitle = title
  ? `${title}${SITE.seo.titleSeparator}${SITE.seo.titleSuffix}`
  : SITE.siteName;

const canonicalURL = canonical
  ? new URL(canonical, SITE.siteURL).toString()
  : new URL(Astro.url.pathname, SITE.siteURL).toString();

const ogImageURL = ogImage
  ? (ogImage.startsWith('http') ? ogImage : new URL(ogImage, SITE.siteURL).toString())
  : new URL(SITE.defaultOGImage, SITE.siteURL).toString();

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.siteName} />
    <meta property="og:image" content={ogImageURL} />
    {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    {author && <meta property="article:author" content={author} />}

    <!-- Twitter/X Card -->
    <meta name="twitter:card" content={SITE.seo.twitterCard} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    {SITE.seo.twitterSite && <meta name="twitter:site" content={SITE.seo.twitterSite} />}

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title={SITE.rss.title} href="/rss.xml" />

    <!-- Favicon -->
    <link rel="icon" href={SITE.favicon} />

    <!-- Schema.org structured data -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Analytics (optional, disabled by default) -->
    {SITE.analytics.enabled && SITE.analytics.provider === 'plausible' && (
      <script defer data-domain={SITE.analytics.dataId} src={SITE.analytics.scriptSrc} />
    )}
    {SITE.analytics.enabled && SITE.analytics.provider === 'umami' && (
      <script defer data-website-id={SITE.analytics.dataId} src={SITE.analytics.scriptSrc} />
    )}

  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <header class="site-header" role="banner">
      <div class="site-header__inner">
        <a href="/" class="site-logo">{SITE.siteName}</a>

        <nav class="site-nav" id="site-nav" aria-label="Main navigation">
          {SITE.navigation.map((item) => (
            <a
              href={item.href}
              aria-current={currentPath === item.href || currentPath.startsWith(item.href === '/' ? '/_never_' : item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}

        </nav>

        <button
          class="nav-toggle"
          id="nav-toggle"
          aria-controls="site-nav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          MENU
        </button>
      </div>
    </header>

    <main id="main-content" class="site-main">
      <slot />
    </main>

    <footer class="site-footer" role="contentinfo">
      <div class="site-footer__inner">
        <div class="footer-brand">
          <a href="/" class="footer-brand__name">{SITE.siteName}</a>
          <p class="footer-brand__desc">{SITE.author} — {SITE.authorRole}</p>
        </div>

        <nav class="footer-links" aria-label="Footer navigation">
          <a href="/latest/">Latest</a>
          <a href="/archive/">Archive</a>
          <a href="/categories/">Categories</a>
          <a href="/tags/">Tags</a>
          <a href="/about/">About</a>
          <a href="/rss.xml">RSS</a>
          {SITE.social.github && <a href={SITE.social.github} rel="noopener noreferrer" target="_blank">GitHub</a>}
        </nav>

        <div class="footer-copy">
          &copy; {new Date().getFullYear()} {SITE.author}. Published with BLOG-CMS.
        </div>
      </div>
    </footer>

    <script>
      // Mobile nav toggle
      const toggle = document.getElementById('nav-toggle');
      const nav = document.getElementById('site-nav');
      if (toggle && nav) {
        toggle.addEventListener('click', () => {
          const isOpen = nav.classList.toggle('is-open');
          toggle.setAttribute('aria-expanded', String(isOpen));
          toggle.textContent = isOpen ? 'CLOSE' : 'MENU';
        });
      }
    </script>
  </body>
</html>
