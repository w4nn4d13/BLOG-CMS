---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllPosts, getHashtags } from '@/utils/posts';

const allPosts = await getAllPosts();
const hashtags = getHashtags(allPosts);
---

<BaseLayout title="Hashtags" description="Browse all hashtags used in articles">
  <div class="page-hdr">
    <div class="page-hdr__label">Taxonomy / Index</div>
    <h1 class="page-hdr__title">Hashtag Index</h1>
    <div class="page-hdr__desc">{hashtags.length} hashtags · {allPosts.length} articles</div>
  </div>

  <div class="section-block">
    <div class="section-bar">
      <span class="section-bar__num">01</span>
      <span class="section-bar__title">Hashtag Directory</span>
    </div>
    <table class="dir-table">
      <thead>
        <tr>
          <th>No.</th>
          <th>Hashtag</th>
          <th style="text-align:right;">Articles</th>
        </tr>
      </thead>
      <tbody>
        {hashtags.map((ht, i) => (
          <tr>
            <td style="font-family:var(--font-mono);font-size:var(--text-xs);color:var(--text-subtle);width:48px;">
              {String(i+1).padStart(3,'0')}
            </td>
            <td class="dir-table__name">
              <a href={`/hashtag/${ht.normalized}/`} style="font-family:var(--font-mono);">
                #{ht.display}
              </a>
            </td>
            <td class="dir-table__count">{ht.count}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</BaseLayout>
