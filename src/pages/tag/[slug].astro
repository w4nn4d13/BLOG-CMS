---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllPosts, getTags, getPostUrl, formatDate } from '@/utils/posts';
import { slugify, normalizeHashtag } from '@/utils/slugify';

export async function getStaticPaths() {
  const allPosts = await getAllPosts();
  return getTags(allPosts).map(tag => ({
    params: { slug: tag.slug },
    props: { tagName: tag.name, count: tag.count },
  }));
}

const { tagName, count } = Astro.props;
const allPosts = await getAllPosts();
const posts = allPosts.filter(p => p.data.tags.some(t => slugify(t) === Astro.params.slug));
---

<BaseLayout title={`Tag: ${tagName}`} description={`${count} articles tagged with ${tagName}`}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <span class="breadcrumb__item"><a href="/">Home</a></span>
    <span class="breadcrumb__item"><a href="/tags/">Tags</a></span>
    <span class="breadcrumb__item"><span class="breadcrumb__current">{tagName}</span></span>
  </nav>

  <div class="page-hdr">
    <div class="page-hdr__label">Tag Archive</div>
    <h1 class="page-hdr__title">{tagName}</h1>
    <div class="page-hdr__desc">{count} article{count !== 1 ? 's' : ''}</div>
  </div>

  <div class="section-block">
    <div class="section-bar">
      <span class="section-bar__num">01</span>
      <span class="section-bar__title">Tagged: {tagName}</span>
    </div>
    <ul class="pub-list">
      {posts.map((post, i) => (
        <li class="pub-row">
          <span class="pub-row__num">{String(i+1).padStart(3,'0')}</span>
          <time class="pub-row__date" datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date,'short')}
          </time>
          <a href={`/category/${slugify(post.data.category)}/`} class="pub-row__cat">
            {post.data.category}
          </a>
          <div class="pub-row__main">
            <div class="pub-row__title"><a href={getPostUrl(post)}>{post.data.title}</a></div>
            <div class="pub-row__desc">{post.data.description}</div>
          </div>
          <div class="pub-row__badges">
            {post.data.featured && <span class="badge badge--fill">FEATURED</span>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
