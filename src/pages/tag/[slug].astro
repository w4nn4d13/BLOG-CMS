---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllPosts, getTags, getPostUrl, formatDate } from '@/utils/posts';
import { slugify } from '@/utils/slugify';

export async function getStaticPaths() {
  const allPosts = await getAllPosts();
  const tags = getTags(allPosts);
  return tags.map((tag) => ({
    params: { slug: tag.slug },
    props: { tagName: tag.name, count: tag.count },
  }));
}

const { tagName, count } = Astro.props;
const allPosts = await getAllPosts();
const posts = allPosts.filter((p) => p.data.tags.some((t) => slugify(t) === Astro.params.slug));
---

<BaseLayout
  title={`Tag: ${tagName}`}
  description={`${count} articles tagged with ${tagName}`}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <span class="breadcrumb__item"><a href="/">Home</a></span>
    <span class="breadcrumb__item"><a href="/tags/">Tags</a></span>
    <span class="breadcrumb__item"><span class="breadcrumb__current">{tagName}</span></span>
  </nav>

  <div class="page-header">
    <div class="page-header__label">Tag</div>
    <h1 class="page-header__title">{tagName}</h1>
    <p class="page-header__desc">{count} article{count !== 1 ? 's' : ''}</p>
  </div>

  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-row">
        <time class="post-row__date" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date, 'short')}
        </time>
        <div class="post-row__main">
          <div class="post-row__title">
            <a href={getPostUrl(post)}>{post.data.title}</a>
          </div>
          <div class="post-row__desc">{post.data.description}</div>
          <div class="post-row__meta">
            <a href={`/category/${slugify(post.data.category)}/`}>{post.data.category}</a>
          </div>
        </div>
        <div class="post-row__badges">
          {post.data.featured && <span class="badge badge--filled">FEATURED</span>}
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>
