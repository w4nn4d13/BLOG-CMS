---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllPosts, getSeries, getPostUrl, formatDate } from '@/utils/posts';

export async function getStaticPaths() {
  const allPosts = await getAllPosts();
  return getSeries(allPosts).map(s => ({
    params: { slug: s.slug },
    props: { seriesName: s.name, count: s.count, posts: s.posts },
  }));
}

const { seriesName, count, posts } = Astro.props;
---

<BaseLayout title={`Series: ${seriesName}`} description={`${count}-part series: ${seriesName}`}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <span class="breadcrumb__item"><a href="/">Home</a></span>
    <span class="breadcrumb__item"><a href="/series/">Series</a></span>
    <span class="breadcrumb__item"><span class="breadcrumb__current">{seriesName}</span></span>
  </nav>

  <div class="page-hdr">
    <div class="page-hdr__label">Series — {count} parts</div>
    <h1 class="page-hdr__title">{seriesName}</h1>
  </div>

  <div class="section-block">
    <div class="section-bar">
      <span class="section-bar__num">SER</span>
      <span class="section-bar__title">{seriesName}</span>
    </div>
    <ul class="pub-list">
      {posts.map((post, i) => (
        <li class="pub-row">
          <span class="pub-row__num">PT.{post.data.seriesOrder ?? i+1}</span>
          <time class="pub-row__date" datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date,'short')}
          </time>
          <span class="pub-row__cat" style="color:var(--text-subtle);">Part {post.data.seriesOrder ?? i+1}</span>
          <div class="pub-row__main">
            <div class="pub-row__title"><a href={getPostUrl(post)}>{post.data.title}</a></div>
            <div class="pub-row__desc">{post.data.description}</div>
          </div>
          <div class="pub-row__badges"></div>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
