---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllPosts, getSeries } from '@/utils/posts';

const allPosts   = await getAllPosts();
const seriesList = getSeries(allPosts);
---

<BaseLayout title="Article Series" description="Multi-part article series">
  <div class="page-hdr">
    <div class="page-hdr__label">Publications</div>
    <h1 class="page-hdr__title">Series</h1>
    <div class="page-hdr__desc">{seriesList.length} series</div>
  </div>

  <div class="section-block">
    <div class="section-bar">
      <span class="section-bar__num">01</span>
      <span class="section-bar__title">Series Directory</span>
    </div>
    <table class="dir-table">
      <thead>
        <tr>
          <th>No.</th>
          <th>Series</th>
          <th style="text-align:right;">Parts</th>
        </tr>
      </thead>
      <tbody>
        {seriesList.map((s, i) => (
          <tr>
            <td style="font-family:var(--font-mono);font-size:var(--text-xs);color:var(--text-subtle);width:48px;">
              {String(i+1).padStart(3,'0')}
            </td>
            <td class="dir-table__name">
              <a href={`/series/${s.slug}/`}>{s.name}</a>
            </td>
            <td class="dir-table__count">{s.count}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</BaseLayout>
