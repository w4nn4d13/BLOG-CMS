---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import {
  getAllPosts, getCategories, getHashtags, getArchiveByYear,
  getPostUrl, formatDate
} from '@/utils/posts';
import { slugify, normalizeHashtag } from '@/utils/slugify';

const allPosts      = await getAllPosts();
const featured      = allPosts.filter(p => p.data.featured).slice(0, 3);
const pinned        = allPosts.filter(p => p.data.pinned && !p.data.featured).slice(0, 5);
const latest        = allPosts.slice(0, SITE.postsPerPage);
const categories    = getCategories(allPosts).slice(0, 10);
const topHashtags   = getHashtags(allPosts).slice(0, 18);
const archive       = getArchiveByYear(allPosts);
const archiveYears  = [...archive.keys()].sort((a,b)=>b-a).slice(0,4);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.siteName,
  description: SITE.siteDescription,
  url: SITE.siteURL,
  author: { '@type': 'Person', name: SITE.author },
};
---

<BaseLayout description={SITE.siteDescription} schema={schema}>
  <div class="home-layout">

    <!-- ═══════════════════════════════ MAIN ═══════════════════════════════ -->
    <div class="home-main">

      <!-- ── FEATURED ── -->
      {featured.length > 0 && (
        <div class="section-block">
          <div class="section-bar">
            <span class="section-bar__num">01</span>
            <span class="section-bar__title">Featured Publications</span>
            <a href="/latest/" class="section-bar__more">ALL PUBLICATIONS →</a>
          </div>
          {featured.map(post => (
            <div class="featured-block">
              <div class="featured-block__head">
                [ FEATURED ] — {post.data.category}
              </div>
              <div class="featured-block__body">
                <a href={`/category/${slugify(post.data.category)}/`} class="featured-block__cat">
                  {post.data.category}
                </a>
                <h2 class="featured-block__title">
                  <a href={getPostUrl(post)}>{post.data.title}</a>
                </h2>
                <p class="featured-block__desc">{post.data.description}</p>
                <div class="featured-block__meta">
                  <time datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date, 'short').toUpperCase()}
                  </time>
                  <span>{post.data.author}</span>
                  {post.data.tags.slice(0,3).map(t => (
                    <a href={`/tag/${slugify(t)}/`}>{t}</a>
                  ))}
                  {post.data.hashtags.slice(0,3).map(ht => (
                    <a href={`/hashtag/${normalizeHashtag(ht)}/`} class="htag">#{ht.replace(/^#/,'')}</a>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      )}

      <!-- ── PINNED ── -->
      {pinned.length > 0 && (
        <div class="section-block">
          <div class="section-bar section-bar--alt">
            <span class="section-bar__num">02</span>
            <span class="section-bar__title">Pinned</span>
          </div>
          <ul class="pub-list">
            {pinned.map((post, i) => (
              <li class="pub-row">
                <span class="pub-row__num">{String(i+1).padStart(3,'0')}</span>
                <time class="pub-row__date" datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date,'short')}
                </time>
                <a href={`/category/${slugify(post.data.category)}/`} class="pub-row__cat">
                  {post.data.category}
                </a>
                <div class="pub-row__main">
                  <div class="pub-row__title">
                    <a href={getPostUrl(post)}>{post.data.title}</a>
                  </div>
                  <div class="pub-row__desc">{post.data.description}</div>
                </div>
                <div class="pub-row__badges">
                  <span class="badge badge--fill">PINNED</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- ── LATEST PUBLICATIONS ── -->
      <div class="section-block">
        <div class="section-bar">
          <span class="section-bar__num">{featured.length > 0 || pinned.length > 0 ? '03' : '01'}</span>
          <span class="section-bar__title">Latest Publications</span>
          <a href="/latest/" class="section-bar__more">VIEW ALL {allPosts.length} →</a>
        </div>
        <ul class="pub-list">
          {latest.map((post, i) => (
            <li class="pub-row">
              <span class="pub-row__num">{String(i+1).padStart(3,'0')}</span>
              <time class="pub-row__date" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date,'short')}
              </time>
              <a href={`/category/${slugify(post.data.category)}/`} class="pub-row__cat">
                {post.data.category}
              </a>
              <div class="pub-row__main">
                <div class="pub-row__title">
                  <a href={getPostUrl(post)}>{post.data.title}</a>
                </div>
                <div class="pub-row__desc">{post.data.description}</div>
                <div class="pub-row__tags">
                  {post.data.tags.slice(0,4).map(t => (
                    <a href={`/tag/${slugify(t)}/`}>{t}</a>
                  ))}
                  {post.data.hashtags.slice(0,3).map(ht => (
                    <a href={`/hashtag/${normalizeHashtag(ht)}/`} class="htag">#{ht.replace(/^#/,'')}</a>
                  ))}
                </div>
              </div>
              <div class="pub-row__badges">
                {post.data.featured && <span class="badge badge--fill">FEATURED</span>}
              </div>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- ═══════════════════════════════ SIDEBAR ═══════════════════════════════ -->
    <aside class="home-aside">

      <!-- Categories -->
      <div class="sb-block">
        <div class="sb-block__head">
          Categories
          <a href="/categories/">All →</a>
        </div>
        <ul class="sb-list" style="padding: 4px 0 2px;">
          {categories.map(cat => (
            <li class="sb-item" style="padding: 2px 8px;">
              <a href={`/category/${cat.slug}/`} class="sb-item__name">{cat.name}</a>
              <span class="sb-item__dots"></span>
              <span class="sb-item__count">{cat.count}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Hashtags -->
      {topHashtags.length > 0 && (
        <div class="sb-block">
          <div class="sb-block__head">
            Hashtags
            <a href="/hashtags/">All →</a>
          </div>
          <div class="sb-tags">
            {topHashtags.map(ht => (
              <a href={`/hashtag/${ht.normalized}/`}>
                #{ht.display}<span class="sb-tags__count">{ht.count}</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Archive -->
      <div class="sb-block">
        <div class="sb-block__head">
          Archive
          <a href="/archive/">Full →</a>
        </div>
        <ul class="sb-list" style="padding: 4px 0 2px;">
          {archiveYears.map(year => {
            const yearMap = archive.get(year)!;
            const total = [...yearMap.values()].reduce((s,ps)=>s+ps.length,0);
            return (
              <li class="sb-item" style="padding: 2px 8px;">
                <a href={`/archive/#year-${year}`} class="sb-item__name">{year}</a>
                <span class="sb-item__dots"></span>
                <span class="sb-item__count">{total}</span>
              </li>
            );
          })}
        </ul>
      </div>

      <!-- Quick navigation -->
      <div class="sb-block">
        <div class="sb-block__head">Quick Navigation</div>
        <div class="sb-block__body" style="padding: 4px 0 2px;">
          {[
            ['/latest/', 'Latest Publications'],
            ['/categories/', 'All Categories'],
            ['/tags/', 'All Tags'],
            ['/hashtags/', 'All Hashtags'],
            ['/archive/', 'Publication Archive'],
            ['/series/', 'Article Series'],
            ['/search/', 'Search'],
            ['/rss.xml', 'RSS Feed'],
          ].map(([href, label]) => (
            <a
              href={href}
              style="display:block; font-family:var(--font-ui); font-size:var(--text-xs); color:var(--text-muted); text-decoration:none; padding:2px 8px; border-bottom:1px solid var(--border);"
            >
              › {label}
            </a>
          ))}
        </div>
      </div>

    </aside>
  </div>
</BaseLayout>
