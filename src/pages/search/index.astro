---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllPosts, getPostUrl, formatDate } from '@/utils/posts';
import { slugify } from '@/utils/slugify';

const allPosts = await getAllPosts();
const searchIndex = allPosts.map(post => ({
  title:       post.data.title,
  description: post.data.description,
  url:         getPostUrl(post),
  category:    post.data.category,
  tags:        post.data.tags,
  hashtags:    post.data.hashtags.map(h => h.replace(/^#/, '')),
  author:      post.data.author,
  date:        post.data.date.toISOString().slice(0, 10),
}));
---

<BaseLayout title="Search" description="Search all publications">
  <div class="page-hdr">
    <div class="page-hdr__label">Publication Search</div>
    <h1 class="page-hdr__title">Search</h1>
    <div class="page-hdr__desc">Search across titles, descriptions, categories, tags, and hashtags.</div>
  </div>

  <form class="search-wrap" role="search" id="search-form" onsubmit="return false;">
    <input
      type="search"
      id="search-input"
      name="q"
      placeholder="Search publications…"
      aria-label="Search publications"
      autocomplete="off"
      spellcheck="false"
    />
    <button type="submit" aria-label="Search">SEARCH</button>
  </form>

  <div id="search-status" class="search-status" aria-live="polite" style="min-height:1.4em;"></div>

  <div class="section-block" id="search-results-wrap" style="display:none;">
    <div class="section-bar">
      <span class="section-bar__num">→</span>
      <span class="section-bar__title" id="results-bar-title">Results</span>
    </div>
    <ul class="pub-list" id="search-results" role="list"></ul>
  </div>

  <div id="search-empty" style="display:none;font-family:var(--font-mono);font-size:var(--text-sm);color:var(--text-subtle);padding:var(--sp-8);">
    No publications found for this search.
  </div>
</BaseLayout>

<script define:vars={{ searchIndex }}>
  const input   = document.getElementById('search-input');
  const results = document.getElementById('search-results');
  const status  = document.getElementById('search-status');
  const empty   = document.getElementById('search-empty');
  const wrap    = document.getElementById('search-results-wrap');
  const barTitle = document.getElementById('results-bar-title');

  function esc(t) {
    return t.replace(/[&<>"']/g, c =>
      ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  function highlight(text, q) {
    if (!q) return esc(text);
    const safe = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    return esc(text).replace(new RegExp(`(${safe})`, 'gi'), '<mark>$1</mark>');
  }

  function search(query) {
    const q = query.trim().toLowerCase();
    if (!q) {
      results.innerHTML = '';
      status.textContent = '';
      empty.style.display = 'none';
      wrap.style.display = 'none';
      return;
    }

    const tokens = q.split(/\s+/);
    const matched = searchIndex.filter(item => {
      const hay = [item.title, item.description, item.category, item.author,
        ...item.tags, ...item.hashtags].join(' ').toLowerCase();
      return tokens.every(t => hay.includes(t));
    });

    status.textContent = matched.length === 0
      ? '' : `${matched.length} result${matched.length !== 1 ? 's' : ''} for "${query}"`;

    empty.style.display   = matched.length === 0 ? 'block' : 'none';
    wrap.style.display    = matched.length > 0 ? 'block' : 'none';
    if (barTitle) barTitle.textContent = `Results (${matched.length})`;

    results.innerHTML = matched.map((item, i) => `
      <li class="pub-row">
        <span class="pub-row__num">${String(i+1).padStart(3,'0')}</span>
        <time class="pub-row__date">${item.date}</time>
        <span class="pub-row__cat">${esc(item.category)}</span>
        <div class="pub-row__main">
          <div class="pub-row__title">
            <a href="${item.url}">${highlight(item.title, q)}</a>
          </div>
          <div class="pub-row__desc">${highlight(item.description, q)}</div>
          <div class="pub-row__tags">
            ${item.tags.slice(0,3).map(t => `<span>${esc(t)}</span>`).join('')}
          </div>
        </div>
      </li>
    `).join('');
  }

  const params  = new URLSearchParams(window.location.search);
  const initial = params.get('q') || '';
  if (initial && input) { input.value = initial; search(initial); }

  input?.addEventListener('input', e => {
    const q = e.target.value;
    search(q);
    const url = new URL(window.location.href);
    q ? url.searchParams.set('q', q) : url.searchParams.delete('q');
    window.history.replaceState({}, '', url.toString());
  });
</script>
