---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllPosts, getArchiveByYear, getPostUrl, formatDate, MONTH_NAMES } from '@/utils/posts';

const allPosts = await getAllPosts();
const archive  = getArchiveByYear(allPosts);
const years    = [...archive.keys()].sort((a,b) => b - a);
---

<BaseLayout
  title="Publication Archive"
  description={`Complete archive of ${allPosts.length} articles organised by date`}
>
  <div class="page-hdr">
    <div class="page-hdr__label">Publication Archive</div>
    <h1 class="page-hdr__title">Archive</h1>
    <div class="page-hdr__desc">{allPosts.length} articles published</div>
  </div>

  {years.map(year => {
    const yearMap = archive.get(year)!;
    const months  = [...yearMap.keys()].sort((a,b) => b - a);
    const total   = months.reduce((s,m) => s + yearMap.get(m)!.length, 0);

    return (
      <div class="archive-year" id={`year-${year}`}>
        <h2 class="archive-year__head">
          {year}
          <span class="archive-year__count">{total} articles</span>
        </h2>

        {months.map(month => {
          const mPosts = yearMap.get(month)!;
          return (
            <div class="archive-month">
              <h3 class="archive-month__head">
                {MONTH_NAMES[month-1].toUpperCase()} {year}
                &nbsp;·&nbsp; {mPosts.length} article{mPosts.length !== 1 ? 's' : ''}
              </h3>
              <ul class="pub-list" style="border:1px solid var(--border);border-top:none;margin-bottom:var(--sp-4);">
                {mPosts.map((post, i) => (
                  <li class="pub-row">
                    <span class="pub-row__num">{String(i+1).padStart(3,'0')}</span>
                    <time class="pub-row__date" datetime={post.data.date.toISOString()}>
                      {formatDate(post.data.date,'short')}
                    </time>
                    <a href={`/category/${post.data.category.toLowerCase().replace(/\s+/g,'-')}/`} class="pub-row__cat">
                      {post.data.category}
                    </a>
                    <div class="pub-row__main">
                      <div class="pub-row__title"><a href={getPostUrl(post)}>{post.data.title}</a></div>
                    </div>
                    <div class="pub-row__badges">
                      {post.data.featured && <span class="badge badge--fill">FEATURED</span>}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
    );
  })}

  {allPosts.length === 0 && (
    <p style="font-family:var(--font-mono);color:var(--text-subtle);padding:var(--sp-8);">
      No articles published yet.
    </p>
  )}
</BaseLayout>
