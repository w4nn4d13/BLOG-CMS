---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllPosts, getCategories, getPostUrl, formatDate } from '@/utils/posts';
import { slugify, normalizeHashtag } from '@/utils/slugify';

export async function getStaticPaths() {
  const allPosts = await getAllPosts();
  const categories = getCategories(allPosts);
  return categories.map(cat => ({
    params: { slug: cat.slug },
    props: { categoryName: cat.name, count: cat.count },
  }));
}

const { categoryName, count } = Astro.props;
const allPosts = await getAllPosts();
const posts = allPosts.filter(p => slugify(p.data.category) === Astro.params.slug);
---

<BaseLayout title={`Category: ${categoryName}`} description={`${count} articles in ${categoryName}`}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <span class="breadcrumb__item"><a href="/">Home</a></span>
    <span class="breadcrumb__item"><a href="/categories/">Categories</a></span>
    <span class="breadcrumb__item"><span class="breadcrumb__current">{categoryName}</span></span>
  </nav>

  <div class="page-hdr">
    <div class="page-hdr__label">Category Archive</div>
    <h1 class="page-hdr__title">{categoryName}</h1>
    <div class="page-hdr__desc">{count} article{count !== 1 ? 's' : ''}</div>
  </div>

  <div class="section-block">
    <div class="section-bar">
      <span class="section-bar__num">01</span>
      <span class="section-bar__title">{categoryName} — Publications</span>
    </div>
    <ul class="pub-list">
      {posts.map((post, i) => (
        <li class="pub-row">
          <span class="pub-row__num">{String(i+1).padStart(3,'0')}</span>
          <time class="pub-row__date" datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date,'short')}
          </time>
          <span class="pub-row__cat" style="color:var(--text-subtle);cursor:default;">{post.data.category}</span>
          <div class="pub-row__main">
            <div class="pub-row__title"><a href={getPostUrl(post)}>{post.data.title}</a></div>
            <div class="pub-row__desc">{post.data.description}</div>
            <div class="pub-row__tags">
              {post.data.tags.slice(0,4).map(t => (
                <a href={`/tag/${slugify(t)}/`}>{t}</a>
              ))}
              {post.data.hashtags.slice(0,3).map(ht => (
                <a href={`/hashtag/${normalizeHashtag(ht)}/`} class="htag">#{ht.replace(/^#/,'')}</a>
              ))}
            </div>
          </div>
          <div class="pub-row__badges">
            {post.data.featured && <span class="badge badge--fill">FEATURED</span>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
