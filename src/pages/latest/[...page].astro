---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllPosts, getPostUrl, formatDate, paginate } from '@/utils/posts';
import { SITE } from '@/config/site';
import { slugify, normalizeHashtag } from '@/utils/slugify';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const total = Math.max(1, Math.ceil(posts.length / SITE.postsPerPage));
  return Array.from({ length: total }, (_, i) => ({
    params: { page: i === 0 ? undefined : String(i + 1) },
    props: { page: i + 1 },
  }));
}

const { page } = Astro.props;
const allPosts = await getAllPosts();
const paged = paginate(allPosts, page, SITE.postsPerPage);
---

<BaseLayout
  title={page === 1 ? 'Latest Publications' : `Latest Publications — Page ${page}`}
  description={`All published articles — page ${page} of ${paged.totalPages}`}
>
  <div class="page-hdr">
    <div class="page-hdr__label">Publication Archive</div>
    <h1 class="page-hdr__title">Latest Publications</h1>
    <div class="page-hdr__desc">{paged.totalItems} articles published</div>
  </div>

  <div class="section-block">
    <div class="section-bar">
      <span class="section-bar__num">01</span>
      <span class="section-bar__title">All Publications</span>
      <span class="section-bar__more" style="pointer-events:none;">
        PAGE {page} / {paged.totalPages}
      </span>
    </div>
    <ul class="pub-list">
      {paged.items.map((post, i) => (
        <li class="pub-row">
          <span class="pub-row__num">{String((page-1)*SITE.postsPerPage + i + 1).padStart(3,'0')}</span>
          <time class="pub-row__date" datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date,'short')}
          </time>
          <a href={`/category/${slugify(post.data.category)}/`} class="pub-row__cat">
            {post.data.category}
          </a>
          <div class="pub-row__main">
            <div class="pub-row__title"><a href={getPostUrl(post)}>{post.data.title}</a></div>
            <div class="pub-row__desc">{post.data.description}</div>
            <div class="pub-row__tags">
              {post.data.tags.slice(0,4).map(t => (
                <a href={`/tag/${slugify(t)}/`}>{t}</a>
              ))}
              {post.data.hashtags.slice(0,3).map(ht => (
                <a href={`/hashtag/${normalizeHashtag(ht)}/`} class="htag">#{ht.replace(/^#/,'')}</a>
              ))}
            </div>
          </div>
          <div class="pub-row__badges">
            {post.data.featured && <span class="badge badge--fill">FEATURED</span>}
            {post.data.pinned && <span class="badge">PINNED</span>}
          </div>
        </li>
      ))}
    </ul>
  </div>

  {paged.totalPages > 1 && (
    <nav class="pagination" aria-label="Pagination">
      <span class="pagination__info">
        Page {paged.currentPage} of {paged.totalPages} — {paged.totalItems} articles
      </span>
      <div class="pagination__links">
        <a
          href={paged.currentPage - 1 === 1 ? '/latest/' : `/latest/${paged.currentPage - 1}/`}
          class={`pagination__link${!paged.hasPrev ? ' pagination__link--disabled' : ''}`}
          aria-label="Previous page"
        >← PREV</a>
        {Array.from({ length: paged.totalPages }, (_, i) => i + 1).map(p => (
          <a
            href={p === 1 ? '/latest/' : `/latest/${p}/`}
            class={`pagination__link${p === paged.currentPage ? ' pagination__link--active' : ''}`}
            aria-current={p === paged.currentPage ? 'page' : undefined}
          >{p}</a>
        ))}
        <a
          href={`/latest/${paged.currentPage + 1}/`}
          class={`pagination__link${!paged.hasNext ? ' pagination__link--disabled' : ''}`}
          aria-label="Next page"
        >NEXT →</a>
      </div>
    </nav>
  )}
</BaseLayout>
