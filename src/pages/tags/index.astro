---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllPosts, getTags } from '@/utils/posts';

const allPosts = await getAllPosts();
const tags = getTags(allPosts);
---

<BaseLayout title="Tags" description="Browse all article tags">
  <div class="page-header">
    <div class="page-header__label">Taxonomy</div>
    <h1 class="page-header__title">Tags</h1>
    <p class="page-header__desc">{tags.length} tags across {allPosts.length} articles</p>
  </div>

  <div class="taxonomy-grid">
    {tags.map((tag) => (
      <a href={`/tag/${tag.slug}/`} class="taxonomy-card">
        <span class="taxonomy-card__name">{tag.name}</span>
        <span class="taxonomy-card__count">{tag.count} article{tag.count !== 1 ? 's' : ''}</span>
      </a>
    ))}
  </div>
</BaseLayout>
