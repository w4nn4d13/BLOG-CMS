---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllPosts, getTags } from '@/utils/posts';

const allPosts = await getAllPosts();
const tags = getTags(allPosts);
---

<BaseLayout title="Tags" description="Browse all article tags">
  <div class="page-hdr">
    <div class="page-hdr__label">Taxonomy / Index</div>
    <h1 class="page-hdr__title">Tags</h1>
    <div class="page-hdr__desc">{tags.length} tags · {allPosts.length} articles</div>
  </div>

  <div class="section-block">
    <div class="section-bar">
      <span class="section-bar__num">01</span>
      <span class="section-bar__title">Tag Directory</span>
    </div>
    <table class="dir-table">
      <thead>
        <tr>
          <th>No.</th>
          <th>Tag</th>
          <th style="text-align:right;">Articles</th>
        </tr>
      </thead>
      <tbody>
        {tags.map((tag, i) => (
          <tr>
            <td style="font-family:var(--font-mono);font-size:var(--text-xs);color:var(--text-subtle);width:48px;">
              {String(i+1).padStart(3,'0')}
            </td>
            <td class="dir-table__name">
              <a href={`/tag/${tag.slug}/`}>{tag.name}</a>
            </td>
            <td class="dir-table__count">{tag.count}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</BaseLayout>
